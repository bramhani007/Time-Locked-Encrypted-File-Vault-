# Set a long random value before deployment. Example generation:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-this-with-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata
# Set to 1 when serving over HTTPS in production.
COOKIE_SECURE=0

# Maximum upload size in megabytes (default: 100 MB).
MAX_UPLOAD_MB=100
